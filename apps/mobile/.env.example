# Public BFF URL for the employee app. These values are bundled into the client. Do not put secrets here.
#
# Local simulator / Expo:
EXPO_PUBLIC_BFF_BASE_URL=http://localhost:3000
# Android emulator (if you do not rely on the api.ts 10.0.2.2 default):
# EXPO_PUBLIC_BFF_BASE_URL=http://10.0.2.2:3000
# Physical device on the same LAN as Compose:
# EXPO_PUBLIC_BFF_BASE_URL=http://192.168.x.x:3000
# Cloud BFF (after P3-04 deploy; use the Container Apps FQDN, https):
# EXPO_PUBLIC_BFF_BASE_URL=https://<bff-app>.<region>.azurecontainerapps.io
#
# Entra PKCE (P0-01). Redirect URI for Expo: borrowhub://auth
# EXPO_PUBLIC_ENTRA_TENANT_ID=
# EXPO_PUBLIC_ENTRA_CLIENT_ID=
# EXPO_PUBLIC_ENTRA_API_SCOPE=api://borrowhub-bff/access_as_user
