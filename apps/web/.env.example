# Public BFF URL for the admin Vite app. These values are visible in the browser bundle. Do not put secrets here.
#
# Local:
VITE_BFF_BASE_URL=http://localhost:3000
# Cloud BFF (after P3-04 deploy; use https and the Container Apps FQDN):
# VITE_BFF_BASE_URL=https://<bff-app>.<region>.azurecontainerapps.io
#
# Entra PKCE (P0-01). SPA redirect: http://localhost:5173 and https://<static-web-app-host>
# VITE_ENTRA_TENANT_ID=
# VITE_ENTRA_CLIENT_ID=
# VITE_ENTRA_API_SCOPE=api://borrowhub-bff/access_as_user
# VITE_ENTRA_REDIRECT_URI=http://localhost:5173
