# Non-secrets. Database password is a secret — never commit it.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/borrowhub
SPRING_DATASOURCE_USERNAME=borrowhub
SPRING_DATASOURCE_PASSWORD=borrowhub
BORROWHUB_OFFICE_TIMEZONE=Africa/Johannesburg
# Default password matches compose.yaml for local only. Override in cloud via Key Vault.
# Cloud JWT (demo identity stays off outside the `dev` profile):
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUER_URI=https://login.microsoftonline.com/{tenant}/v2.0
# SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES=api://borrowhub-java
